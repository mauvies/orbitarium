# The tutor (spec 05). Copy this file to .env.local and fill it in.

# Google AI Studio API key, free tier: https://aistudio.google.com/apikey
# Required for the tutor; without it the panel says the tutor needs a key.
# @ai-sdk/google reads this exact name.
GOOGLE_GENERATIVE_AI_API_KEY=

# The tutor's model, as provider:model. Optional: when it is unset the tutor
# uses the default below. A value that is not google:<model> disables the tutor.
# TUTOR_MODEL=google:gemini-3.5-flash-lite
